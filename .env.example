# Copia este archivo a ".env" (en la raíz) y ajusta los valores según el
# entorno. Docker Compose lo lee automáticamente. Este archivo NUNCA se sube
# a git (ver .gitignore) — solo .env.example queda versionado.

# ── Backend (9 servicios: 8 microservicios + bff-gateway) ─────────────────────
# "noauth" = sin Azure, JWT no se valida, H2 embebida (demo rápida).
# Vacío ("")= valida JWT real de Azure Entra ID y usa Postgres.
SPRING_PROFILES_ACTIVE=noauth

# Solo importan cuando SPRING_PROFILES_ACTIVE no es "noauth". Reemplaza
# <TENANT_ID> por el Directory (tenant) ID real, y AZURE_AUDIENCE por el
# Application ID URI real del App Registration del backend.
AZURE_ISSUER_URI=https://login.microsoftonline.com/<TENANT_ID>/v2.0
AZURE_AUDIENCE=api://cafeteria-backend

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL base de la API (BFF). En local: http://localhost:8080/api
# En EC2: http://<IP_PUBLICA_EC2>:8080/api
VITE_API_BASE_URL=http://localhost:8080/api

# Deshabilitar autenticación Azure (true = sin login, para desarrollo/demo)
# Cambiar a false cuando Azure Entra ID esté configurado
VITE_AUTH_DISABLED=true

# Solo importan cuando VITE_AUTH_DISABLED=false. FRONTEND_CLIENT_ID = el
# Application (client) ID del App Registration SPA (no del backend).
VITE_AZURE_CLIENT_ID=<FRONTEND_CLIENT_ID>
VITE_AZURE_TENANT_ID=<TENANT_ID>
VITE_AZURE_REDIRECT_URI=http://localhost:4200
VITE_API_SCOPES=api://cafeteria-backend/pedidos.read,api://cafeteria-backend/pedidos.write

# ── BFF Gateway ───────────────────────────────────────────────────────────────
# Origen del frontend permitido en CORS. En local: http://localhost:4200
# En EC2: http://<IP_PUBLICA_EC2>:4200
FRONTEND_ORIGIN=http://localhost:4200
